{
  "about": "The one palette source for Sevjala. Every colour any surface uses is a token here, with its role; `surfaces` maps each surface's own name for a colour to a token. `go run ./scripts/brandcheck` (make brand-check) fails on drift and on any colour with no token. See docs/reference/brand.md.",
  "colors": {
    "brand.navy": { "value": "#14233B", "role": "Net Navy: logo ink (mark and wordmark) on light backgrounds; the app-icon tile" },
    "brand.blue": { "value": "#2457C5", "role": "Sevjala Blue: the blue logo variant; the same colour as the light dashboard accent" },
    "brand.white": { "value": "#FFFFFF", "role": "Reverse logo ink on dark backgrounds; the mark on the app-icon tile; page background" },
    "brand.black": { "value": "#000000", "role": "Monochrome logo ink where colour is not available" },
    "brand.mist": { "value": "#F3F6FB", "role": "Brand guide and review sheets only: page and panel background" },
    "brand.slate": { "value": "#56657A", "role": "Brand guide and review sheets only: secondary text" },
    "brand.rule": { "value": "#DBE2EC", "role": "Brand guide and review sheets only: swatch outline" },

    "ui.light.bg": { "value": "#F6F7F9", "role": "Dashboard, light: page background" },
    "ui.light.card": { "value": "#FFFFFF", "role": "Dashboard, light: cards, header, dialogs" },
    "ui.light.text": { "value": "#1C2330", "role": "Dashboard, light: body text" },
    "ui.light.muted": { "value": "#5B6474", "role": "Dashboard, light: secondary text, inactive nav" },
    "ui.light.line": { "value": "#DDE1E7", "role": "Dashboard, light: borders and rules" },
    "ui.light.green": { "value": "#1A7F37", "role": "Dashboard, light: status OK (text and dot)" },
    "ui.light.green-bg": { "value": "#E6F4EA", "role": "Dashboard, light: status OK background" },
    "ui.light.yellow": { "value": "#A15C00", "role": "Dashboard, light: status needs a look" },
    "ui.light.yellow-bg": { "value": "#FFF4DC", "role": "Dashboard, light: needs-a-look background" },
    "ui.light.red": { "value": "#C62828", "role": "Dashboard, light: status problem; danger buttons" },
    "ui.light.red-bg": { "value": "#FDECEA", "role": "Dashboard, light: problem background" },
    "ui.light.grey": { "value": "#6B7280", "role": "Dashboard, light: status unknown or offline" },
    "ui.light.grey-bg": { "value": "#EEF0F3", "role": "Dashboard, light: neutral fill (code, active nav)" },
    "ui.light.accent": { "ref": "brand.blue", "role": "Dashboard, light: primary buttons, links, focus" },
    "ui.light.brand-ink": { "ref": "brand.navy", "role": "Dashboard, light: the header mark and wordmark (the lockup's ink)" },

    "ui.dark.bg": { "value": "#12161D", "role": "Dashboard, dark: page background" },
    "ui.dark.card": { "value": "#1B212B", "role": "Dashboard, dark: cards, header, dialogs" },
    "ui.dark.text": { "value": "#E6E9EF", "role": "Dashboard, dark: body text" },
    "ui.dark.muted": { "value": "#9AA3B2", "role": "Dashboard, dark: secondary text, inactive nav" },
    "ui.dark.line": { "value": "#2D3542", "role": "Dashboard, dark: borders and rules" },
    "ui.dark.green": { "value": "#4CC26E", "role": "Dashboard, dark: status OK" },
    "ui.dark.green-bg": { "value": "#15301F", "role": "Dashboard, dark: status OK background" },
    "ui.dark.yellow": { "value": "#F0B44C", "role": "Dashboard, dark: status needs a look" },
    "ui.dark.yellow-bg": { "value": "#3A2C10", "role": "Dashboard, dark: needs-a-look background" },
    "ui.dark.red": { "value": "#FF6B6B", "role": "Dashboard, dark: status problem; danger buttons" },
    "ui.dark.red-bg": { "value": "#3B1717", "role": "Dashboard, dark: problem background" },
    "ui.dark.grey": { "value": "#9AA3B2", "role": "Dashboard, dark: status unknown or offline" },
    "ui.dark.grey-bg": { "value": "#252C37", "role": "Dashboard, dark: neutral fill (code, active nav)" },
    "ui.dark.accent": { "value": "#7AA2FF", "role": "Dashboard, dark: primary buttons, links, focus (Sevjala Blue lifted for a dark background)" },

    "ui.on-fill": { "ref": "brand.white", "role": "Dashboard, both themes: text on filled accent and danger buttons" },
    "ui.scrim": { "value": "#00000073", "role": "Dashboard, both themes: the backdrop behind a confirmation dialog (black at 45%)" },

    "tray.green": { "value": "#2EA043", "role": "Tray: OK status dot. Tray dots are mid-tones that read on both light and dark taskbars, so they differ from the dashboard's text-on-card status colours" },
    "tray.yellow": { "value": "#E3A008", "role": "Tray: needs-a-look status dot" },
    "tray.red": { "value": "#D03030", "role": "Tray: problem status dot" },
    "tray.grey": { "value": "#8A8A8A", "role": "Tray: unknown status dot (agent not reachable)" },
    "tray.ring": { "ref": "brand.white", "role": "Tray: the ring that separates the status dot from the icon" }
  },
  "surfaces": [
    { "file": "ui/src/app.css", "key": "--bg", "token": "ui.light.bg" },
    { "file": "ui/src/app.css", "key": "--card", "token": "ui.light.card" },
    { "file": "ui/src/app.css", "key": "--text", "token": "ui.light.text" },
    { "file": "ui/src/app.css", "key": "--muted", "token": "ui.light.muted" },
    { "file": "ui/src/app.css", "key": "--line", "token": "ui.light.line" },
    { "file": "ui/src/app.css", "key": "--green", "token": "ui.light.green" },
    { "file": "ui/src/app.css", "key": "--green-bg", "token": "ui.light.green-bg" },
    { "file": "ui/src/app.css", "key": "--yellow", "token": "ui.light.yellow" },
    { "file": "ui/src/app.css", "key": "--yellow-bg", "token": "ui.light.yellow-bg" },
    { "file": "ui/src/app.css", "key": "--red", "token": "ui.light.red" },
    { "file": "ui/src/app.css", "key": "--red-bg", "token": "ui.light.red-bg" },
    { "file": "ui/src/app.css", "key": "--grey", "token": "ui.light.grey" },
    { "file": "ui/src/app.css", "key": "--grey-bg", "token": "ui.light.grey-bg" },
    { "file": "ui/src/app.css", "key": "--accent", "token": "ui.light.accent" },
    { "file": "ui/src/app.css", "key": "--bg@dark", "token": "ui.dark.bg" },
    { "file": "ui/src/app.css", "key": "--card@dark", "token": "ui.dark.card" },
    { "file": "ui/src/app.css", "key": "--text@dark", "token": "ui.dark.text" },
    { "file": "ui/src/app.css", "key": "--muted@dark", "token": "ui.dark.muted" },
    { "file": "ui/src/app.css", "key": "--line@dark", "token": "ui.dark.line" },
    { "file": "ui/src/app.css", "key": "--green@dark", "token": "ui.dark.green" },
    { "file": "ui/src/app.css", "key": "--green-bg@dark", "token": "ui.dark.green-bg" },
    { "file": "ui/src/app.css", "key": "--yellow@dark", "token": "ui.dark.yellow" },
