    { "file": "ui/src/app.css", "key": "#FFFFFF", "token": "ui.on-fill" },
    { "file": "ui/src/Dashboard.svelte", "key": "#FFFFFF", "token": "ui.on-fill" },
    { "file": "ui/src/Confirm.svelte", "key": "#00000073", "token": "ui.scrim" },
    { "file": "tray/icon.go", "key": "Green", "token": "tray.green" },
    { "file": "tray/icon.go", "key": "Yellow", "token": "tray.yellow" },
